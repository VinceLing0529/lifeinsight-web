    "final_report_template": {
        "description": "最终报告总结的prompt模板",
        "template": "你是一位精通中国传统命理学和印度占星学的大师。\n\n请基于用户命盘信息和以下四个模块的分析结果，生成一个完整的命理分析报告总结：\n\n优劣混合分析：{comprehensive_analysis}\n思维导图呈现：{mindmap_presentation}\n运势预测报告：{fortune_prediction}\n个性化建议：{personalized_advice}\n\n请综合四个模块的分析，生成一个简洁的报告总结，包含：\n1. 核心命理特征概括\n2. 关键发现和洞察\n3. 重要建议和指导\n\n请严格以JSON格式返回：\n{\n    \"report_summary\": \"综合报告总结内容（200-300字）\"\n}\n\n请确保返回的是纯JSON格式，不要包含任何其他文字。"
    },
    "api_endpoints": {
        "setup_context": {
            "url": "/ai/analysis/setup-context",
            "method": "POST",
            "description": "第一阶段：建立用户命盘上下文",
            "request": {
                "user_data": "完整的用户命理数据",
                "order_id": "生成的订单号"
            },
            "response": {
                "success": true,
                "message": "命盘上下文建立成功",
                "order_id": "订单号"
            }
        },
        "batch_generate": {
            "url": "/ai/analysis/batch-generate",
            "method": "POST",
            "description": "第二阶段：批量生成所有维度分析",
            "request": {
                "order_id": "订单号"
            },
            "response": {
                "success": true,
                "order_id": "订单号",
                "progress": 100,
                "data": {
                    "comprehensive_analysis": "优劣混合分析结果",
                    "mindmap_presentation": "思维导图呈现结果",
                    "fortune_prediction": "运势预测报告结果",
                    "personalized_advice": "个性化建议结果",
                    "final_summary": "最终报告总结"
                }
            }
        }
    },
    "data_flow": {
        "frontend_to_backend": {
            "1_setup_context": "用户点击'立即获取完整报告' → 调用setupContext API → 传入完整user_data",
            "2_batch_generate": "调用batch-generate API → 使用已建立的上下文生成四大模块分析",
            "3_save_report": "保存完整分析结果到data/reports/目录",
            "4_return_data": "返回分析结果给前端显示"
        },
        "prompt_generation": {
            "context_prompt": "create_context_prompt函数根据user_data生成包含所有命理信息的上下文prompt",
            "module_prompts": "四大模块使用各自的prompt_template，不包含用户数据（依赖上下文）",
            "final_prompt": "FINAL_REPORT_TEMPLATE整合四个模块的结果生成最终总结"
        }
    },
    "key_features": {
        "context_isolation": "用户命理数据只在context_prompt中传入，四大模块prompt不包含用户数据",
        "dynamic_time": "运势预测模块动态生成未来12个月的时间信息",
        "fixed_structure": "所有模块都有固定的JSON结构，确保前端UI一致性",
        "ai_generation": "AI只生成内容字段，标题、图标、问题等UI元素都是固定的",
        "order_management": "每个报告都有唯一的订单号，支持历史查询功能"
    }
}