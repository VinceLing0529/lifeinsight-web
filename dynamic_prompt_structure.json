    "context_prompt_template": {
        "description": "create_context_prompt函数生成的上下文建立prompt",
        "template": "你是一位资深的命理分析师，精通八字、紫微斗数和印度星盘三大命理系统。现在请建立对以下用户的完整命盘上下文理解：\n\n【用户基本信息】\n性别：{gender_str}\n出生时间：{birth_date} {birth_time}\n真太阳时：{true_solar_time_json}\n出生地点：{location_name}\n经纬度：{longitude}°E, {latitude}°N\n时区：{timezone} (UTC{utc_offset})\n\n【八字命理信息】\n四柱：{year_pillar} {month_pillar} {day_pillar} {hour_pillar}\n日主：{day_master}火\n身强身弱：{body_strength}\n五行统计：{five_elements_json}\n十神配置：{ten_gods_json}\n{bazi_detail}\n\n【紫微斗数信息】\n{ziwei_detail}\n\n【印度星盘信息】\n{vedic_detail}\n\n请基于以上三大命理系统的完整数据，深度理解这位用户的命盘特征、性格特质、天赋潜力、人生走向等各个方面。这些数据将作为后续分析的基础，请确保充分吸收和理解所有信息。\n\n请回复\"上下文已建立，我已充分理解用户的完整命盘信息\"。"
    },
    "four_analysis_modules": {
        "comprehensive_analysis": {
            "title": "优劣混合分析",
            "description": "AI深度分析您的天赋、内驱力、盲区和成长方向",
            "ai_generated_fields": [
                "summary.overview - 整体命理特征概述（300-400字）",
                "talents.overview - 天赋优势总体分析（100-150字）",
                "tensions.overview - 内心张力特征总体分析（100-150字）",
                "blindspots.overview - 潜在盲区总体分析（100-150字）",
                "guidance.overview - 成长路径总体分析（100-150字）",
                "所有suggestions中的具体内容（个性化调整）"
            ],
            "fixed_fields": [
                "summary.title - 命理综述",
                "talents.title - 天赋优势",
                "tensions.title - 内心张力",
                "blindspots.title - 命盘盲区",
                "guidance.title - 成长引导",
                "所有suggestions中的标题部分"
            ]
        },
        "mindmap_presentation": {
            "title": "思维导图呈现",
            "description": "直观展示您的性格特质和人格结构",
            "ai_generated_fields": [
                "positive_traits.overview - 正向性格特征总体分析（100-150字）",
                "negative_tendencies.overview - 负向性格倾向总体分析（100-150字）",
                "conflicting_aspects.overview - 潜在冲突性格总体分析（100-150字）",
                "strength_areas.overview - 易发展领域总体分析（100-150字）",
                "weakness_areas.overview - 易出问题领域总体分析（100-150字）",
                "positive_traits.details[].title - 6个两字标题",
                "positive_traits.details[].description - 6个一句话总结",
                "negative_tendencies.details[].title - 6个两字标题",
                "negative_tendencies.details[].description - 6个一句话总结",
                "conflicting_aspects.details[].description - 4个分析描述",
                "strength_areas.details[].description - 4个分析描述",
                "weakness_areas.details[].description - 4个分析描述"
            ],
            "fixed_fields": [
                "conflicting_aspects.details[].title - 理性vs感性、行动vs思考、独立vs依赖、完美vs效率",
                "strength_areas.details[].title - 适合行业、人际风格、表达方式、工作特长",
                "weakness_areas.details[].title - 感情破裂点、人际失衡点、健康压力点、资源耗损点"
            ]
        },
        "fortune_prediction": {
