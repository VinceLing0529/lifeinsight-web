# 复制为 .env 后填入你自己的 Key（不要把真实 Key 提交进仓库）
# DeepSeek（主要，OpenAI 兼容接口）
DEEPSEEK_API_KEY=
# Gemini（备用）
GEMINI_API_KEY=
# OpenAI（如使用官方接口）
OPENAI_API_KEY=

# 管理后台（/api/manage-admin）登录凭据——只从环境变量读取，源码里没有默认口令；
# 仓库历史里出现过的旧口令已按泄露处理，切勿再用，请设一个全新的。
MANAGE_ADMIN_USER=
MANAGE_ADMIN_PASS=
# 兑换码存储（可选）：不设则先试本机 Redis，连不上自动落盘到 app/data/redemption_codes.json
# REDIS_URL=redis://localhost:6379/0
